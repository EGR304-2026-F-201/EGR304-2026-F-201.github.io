" /></mxCell><mxCell id="nb2-u3a" value="&lt;b&gt;U3A: Op Amp&lt;/b&gt;&lt;br&gt;(non-inverting buffer)&lt;br&gt;Microchip MCP6002-I/P" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="90" width="170" height="56" as="geometry" /></mxCell><mxCell id="nb2-ldr" value="&lt;b&gt;LDR1: Photoresistor&lt;/b&gt;&lt;br&gt;(cup sensor, off-board on J8)&lt;br&gt;Advanced Photonix PDV-P8103" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="196" width="170" height="60" as="geometry" /></mxCell><mxCell id="nb2-e42" value="Analog (0 - 5VDC, 1 pin)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontFamily=Helvetica;endArrow=classic;endFill=1;strokeWidth=1.2;strokeColor=#000000;fontColor=#000000;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="nb2-ldr" target="nb2-u3a"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="nb2-e43" value="Analog (0 - 5VDC, 1 pin)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontFamily=Helvetica;endArrow=classic;endFill=1;strokeWidth=1.2;strokeColor=#000000;fontColor=#000000;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="nb2-u3a" target="nb2-u3b"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="nb2-e44" value="Analog (0 - 5VDC, 1 pin)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontFamily=Helvetica;endArrow=classic;endFill=1;strokeWidth=1.2;strokeColor=#000000;fontColor=#000000;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="nb2-u3b" target="nb2-lpf"><mxGeometry relative="1" as="geom