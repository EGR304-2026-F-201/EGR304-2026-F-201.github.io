NHD-0216K1Z-FL-YBW&lt;br&gt;R/W to GND, backlight on +5V" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1480" y="-142" width="210" height="104" as="geometry" /></mxCell><mxCell id="nb2-e69" value="Digital - Parallel&lt;br&gt;(5VDC, 6 pins)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontFamily=Helvetica;endArrow=classic;endFill=1;strokeWidth=1.2;strokeColor=#000000;fontColor=#000000;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="nb2-lcdport" target="nb2-ds1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="nb2-rv1" value="&lt;b&gt;RV1:&lt;/b&gt; 10k contrast pot" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="1480" y="0" width="210" height="28" as="geometry" /></mxCell><mxCell id="nb2-e71" value="Analog (0 - 5VDC, 1 pin)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontFamily=Helvetica;endArrow=classic;endFill=1;strokeWidth=1.2;strokeColor=#000000;fontColor=#000000;labelBackgroundColor=#ffffff;exitX=0.5;exitY=0;entryX=0.5;entryY=1;" edge="1" parent="1" source="nb2-rv1" target="nb2-ds1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="nb2-v93" value="&lt;b&gt;Cole: still to update&lt;/b&gt;&lt;br&gt;Your board has 1 output (2 wires): flow status on pin 3 (S1) and pin 4 (S0). 00 no flow, 01 flowing, 10 not used, 11 sensor fault. Outputs start low. Pins 1-2 and 5-7 not used, pin 8 GND. Remove SDA/SCL and the +5V on pin 4 (no power on the ribbon), and show your 2 output pins on your Nano." style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fillColor=#FFFF00;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=10;" vertex="1" parent="1"><mxGeometry x="20" y="1630" width="640" height="80" as="geometry" /></mxCell><mxCell id="nb2-v94" value="&lt;b&gt;Clay: still to update&lt;/b&gt;&lt;br&gt;Your board has 1 input (2 wires) and no outputs: pump command on pin 1 (C1) and pin 2 (C0). 00 stop, 01 run, 10 and 11 stop. Put 100k pull-downs on both, so an unplugged cable means stop. Pins 3-7 not used, pin 8 GND. Remove SDA/SCL and the +5V on pin 4, and show your 2 input pins on your Nano." style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fillColor=#FFFF00;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=10;" vertex="1" parent="1"><mxGeometry x="770" y="1715" width="700" height="80" as="geometry" /></mxCell><mxCell id="nb2-v95" value="&lt;b&gt;Troy: still to update&lt;/b&gt;&lt;br&gt;Your board has 1 input and 1 output (2 wires each): weight command in on pins 1-2 (00/01/10/11 = preset 1-4), weight status out on pins 3-4 (00 not ready, 01 below target, 10 target reached, 11 error). 100k pull-downs on the inputs, outputs start low. Pins 5-7 not used, pin 8 GND. Update this box to your current parts (NAU7802 ADC) and remove SDA/SCL and the +5V from the header." style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fillColor=#FFFF00;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;fontSize=10;" vertex="1" parent="1"><mxGeometry x="1710" y="1665" width="590" height="80" as="geometry" /></mxCell><mxCell id="nb3-v1" value="DI: flow&lt;br&gt;status" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontStyle=1;verticalAlign=top;spacingTop=2;fontSize=9;" vertex="1" parent="1"><mxGeometry x="906" y="132" width="94" height="98" as="geometry" /></mxCell><mxCell id="nb3-v2" value="RC7&lt;br&gt;&lt;span style='font-weight:normal'&gt;S1&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="911" y="182" width="41" height="38" as="geometry" /></mxCell><mxCell id="nb3-v3" value="RC6&lt;br&gt;&lt;span style='font-weight:normal'&gt;S0&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="954" y="182" width="41" height="38" as="geometry" /></mxCell><mxCell id="nb3-v4" value="DO: pump&lt;br&gt;command" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontStyle=1;verticalAlign=top;spacingTop=2;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1004" y="132" width="94" height="98" as="geometry" /></mxCell><mxCell id="nb3-v5" value="RD4&lt;br&gt;&lt;span style='font-weight:normal'&gt;C1&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1009" y="182" width="41" height="38" as="geometry" /></mxCell><mxCell id="nb3-v6" value="RD3&lt;br&gt;&lt;span style='font-weight:normal'&gt;C0&lt;/span&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontStyle=1;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1052" y="182" width="41" height="38" as="geometry" /></mxCell><mxCell id="nb3-v7" value="DO: weight&lt;br&gt;command" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontStyle=1;verticalAlign=top;spacingTop=2;fontSize=9;" vertex="1" parent="1"><mxGeometry x="1102" y="132" width="94" height=