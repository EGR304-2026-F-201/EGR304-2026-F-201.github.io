        <mxCell id="nb2-v1" value="&lt;b style='font-size:22px'&gt;Team Block Diagram -- Team 201: Fill-A-Bot&lt;/b&gt;&lt;br&gt;&lt;span style='font-size:14px'&gt;Nikita Bangiyev (main control), Cole Trask (flow sensing), Clay Belsher (pump control), Troy Reynolds (liquid amount sensing)&lt;/span&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="20" y="-770" width="2280" height="70" as="geometry" /></mxCell><mxCell id="nb2-v2" value="&lt;b style='font-size:14px'&gt;Nikita Bangiyev - Main Control Board&lt;/b&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;align=left;" vertex="1" parent="1"><mxGeometry x="510" y="-655" width="420" height="24" as="geometry" /></mxCell><mxCell id="nb2-v3" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=none;strokeWidth=1.5;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="510" y="-625" width="560" height="145" as="geometry" /></mxCell><mxCell id="nb2-v4" value="&lt;b&gt;+9V DC, Regulated&lt;/b&gt;&lt;br&gt;(wall adapter)&lt;br&gt;Max current: 2A" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="518" y="-617" width="120" height="48" as="geometry" /></mxCell><mxCell id="nb2-v5" value="&lt;b&gt;D6:&lt;/b&gt; +9V power LED" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="518" y="-560" width="120" height="26" as="geometry" /></mxCell><mxCell id="nb2-adp" value="&lt;b&gt;9V 2A Wall Adapter&lt;/b&gt;&lt;br&gt;(off-board)&lt;br&gt;Triad Magnetics&lt;br&gt;WSU090-2000&lt;br&gt;Power (+9V DC)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="1"><mxGeometry x="650" y="-617" width="120" height="88" as="geometry" /></mxCell><mxCell id="nb2-j4" value="&lt;b&gt;J4: Barrel Jack&lt;/b&gt;&lt;br&gt;Same Sky&lt;br&gt;PJ-102AH" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="1"><mxGeometry x="782" y="-617" width="110" height="88" as="geometry" /></mxCell><mxCell id="nb2-f1" value="&lt;b&gt;F1: Fuse T800mA&lt;/b&gt;&lt;br&gt;Littelfuse&lt;br&gt;0218.800MXP" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="1"><mxGeometry x="904" y="-617" width="110" height="70" as="geometry" /></mxCell><mxCell id="nb2-u2" value="&lt;b&gt;U2: 5V LDO Regulator&lt;/b&gt;&lt;br&gt;Texas Instruments LM1086IT-5.0/NOPB&lt;br&gt;Power (+5V DC)&lt;br&gt;heat sink: Same Sky HSE14-384225P" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontSize=9;" vertex="1" parent="1"><mxGeometry x="840" y="-520" width="220" height="78" as="geometry" /></mxCell><mxCell id="nb2-e10" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontFamily=Helvetica;endArrow=classic;endFill=1;strokeWidth=1.2;strokeColor=#000000;fontColor=#000000;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="nb2-adp" target="nb2-j4"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="nb2-e11" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontFamily=Helvetica;endArrow=classic;endFill=1;strokeWidth=1.2;strokeColor=#000000;fontColor=#000000;labelBackgroundColor=#ffffff;exitX=1;exitY=0.315;entryX=0;entryY=0.5;" edge="1" parent="1" source="nb2-j4" target="nb2-f1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="nb2-e12" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontFamily=Helvetica;endArrow=classic;endFill=1;strokeWidth=1.2;strokeColor=#000000;fontColor=#000000;labelBackgroundColor=#ffffff;exitX=0.5;exitY=1;entryX=0.7;entryY=0;" edge="1" parent="1" source="nb2-f1" target="nb2-u2"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="nb2-v13" value="" style="rounded=0;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 6;fillColor=none;strokeWidth=1.5;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="510" y="-480" width="1190" height="900" as="geometry" /></mxCell><mxCell id="nb2-v14" value="&lt;b&gt;+5V DC, Regulated&lt;/b&gt;&lt;br&gt;Max current: 1.5A" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;align=left;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="518" y="-472" width="120" height="36" as="geometry" /></mxCell><mxCell id="nb2-v15" value="&lt;b&gt;D5:&lt;/b&gt; +5V power LED" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="518" y="-428" width="120" height="26" as="geometry" /></mxCell><mxCell id="nb2-v16" value="&lt;b&gt;Notes&lt;/b&gt;&lt;br&gt;Every board has its own adapter and regulator, so no power goes on the ribbon.&lt;br&gt;No UART or I2C between boards. Each signal is 2 GPIO wires = 4 states, and 00 is the safe default. Ribbon: pins 1-2 = main board outputs, pins 3-4 = teammate outputs to main, pins 5-7 not used, pin 8 GND. 100k pull-downs on every input, so an unplugged cable reads 00.&lt;br&gt;&lt;b&gt;Codes:&lt;/b&gt; Pump 00 stop, 01 run. Weight command 00/01/10/11 = preset 1-4. Weight status 00 not ready, 01 below target, 10 target reached, 11 error. Flow 00 no flow, 01 flowing, 11 sensor fault.&lt;br&gt;Yellow = still needs to be updated by that teammate." style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;align=left;verticalAlign=top;spacingLeft=6;spacingTop=3;" vertex="1" parent="1"><mxGeometry x="1090" y="-625" width="610" height="128" as="geometry" /></mxCell><mxCell id="nb2-v17" value="" style="rounded=1;arcSize=2;whiteSpace=wrap;html=1;strokeWidth=2.5;strokeColor=#000000;fillColor=#ffffff;" vertex="1" parent="1"><mxGeometry x="900" y="-400" width="400" height="640" as="geometry" /></mxCell><mxCell id="nb2-v18" value="&lt;b style='font-size:12px'&gt;U1: Microchip PIC18F57Q43 Curiosity Nano&lt;/b&gt;&lt;br&gt;Part #: DM164150 (VTG = +5V, VOFF to GND)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fillColor=none;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="903" y="-397" width="394" height="34" as="geometry" /></mxCell><mxCell id="nb2-v19" value="Digital Input&lt;br&gt;(DI)" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontStyle=1;align=right;spacingRight=6;" vertex="1" parent="1"><mxGeometry x="900" y="-355" width="150" height="205" as="geometry" /></mxCell><mxCell id="nb2-v20" value="&lt;b&gt;Buttons:&lt;/b&gt; Omron B3F-1000, active low" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;fontColor=#000000;fontFamily=Helvetica;align=left;fontSize=9;" vertex="1" parent="1"><mxGeometry x="520" y="-378" width="230" height="26" as="geometry" /></mxCell><mxCell id="nb2-RA0" value="RA0" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="-345" width="48" height="28" as="geometry" /></mxCell><mxCell id="nb2-sw0" value="&lt;b&gt;SW1: UP (next preset)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="-345" width="160" height="28" as="geometry" /></mxCell><mxCell id="nb2-e23" value="Digital - Parallel (5VDC, 1 pin)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontFamily=Helvetica;endArrow=classic;endFill=1;strokeWidth=1.2;strokeColor=#000000;fontColor=#000000;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="nb2-sw0" target="nb2-RA0"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="nb2-RA1" value="RA1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="-306" width="48" height="28" as="geometry" /></mxCell><mxCell id="nb2-sw1" value="&lt;b&gt;SW2: DOWN (last preset)&lt;/b&gt;" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;" vertex="1" parent="1"><mxGeometry x="520" y="-306" width="160" height="28" as="geometry" /></mxCell><mxCell id="nb2-e26" value="Digital - Parallel (5VDC, 1 pin)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;fontFamily=Helvetica;endArrow=classic;endFill=1;strokeWidth=1.2;strokeColor=#000000;fontColor=#000000;labelBackgroundColor=#ffffff;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" parent="1" source="nb2-sw1" target="nb2-RA1"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="nb2-RA2" value="RA2" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="900" y="-267" width="48" height="28" as="geometry" /></mxCell><mxCell id="nb2