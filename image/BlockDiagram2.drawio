        <mxCell id="nb2-v14" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;align=left;spacingLeft=4;" value="&lt;b&gt;+5V DC, Regulated&lt;/b&gt;&lt;br&gt;Max current: 1.5A" vertex="1">
          <mxGeometry height="36" width="120" x="518" y="-472" as="geometry" />
        </mxCell>
        <mxCell id="nb2-v15" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fontSize=10;strokeColor=#000000;fontColor=#000000;fillColor=#ffffff;fontFamily=Helvetica;" value="&lt;b&gt;D5:&lt;/b&gt; +5V power LED" vertex="1">
